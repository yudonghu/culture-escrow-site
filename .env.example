# Domain (staging: hydenluc.com | production: cultureescrow.com)
DOMAIN=hydenluc.com

# NextAuth
NEXTAUTH_SECRET=<openssl rand -hex 32 生成>
NEXTAUTH_URL=https://portal.hydenluc.com
COOKIE_DOMAIN=.hydenluc.com   # staging: .hydenluc.com | production: .cultureescrow.com

# PostgreSQL
POSTGRES_DB=portal
POSTGRES_USER=portal_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://portal_user:change_me@db:5432/portal

# Required for NextAuth behind reverse proxy
AUTH_TRUST_HOST=true

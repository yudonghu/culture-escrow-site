your-domain.com {
    # pg17 tool: protected by forward_auth
    handle /pg17* {
        forward_auth localhost:3000 {
            uri /api/check-auth
            copy_headers Cookie
        }
        reverse_proxy localhost:8787
    }

    # temply tool: protected by forward_auth
    handle /temply* {
        forward_auth localhost:3000 {
            uri /api/check-auth
            copy_headers Cookie
        }
        reverse_proxy localhost:8787
    }

    # Portal main app
    handle {
        reverse_proxy localhost:3000
    }
}
